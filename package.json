{
  "name": "@defra/lis-apps-sheep-home",
  "version": "0.1.0",
  "description": "Home for Sheep spoke application for the livestock taxonomy topology.",
  "sideEffects": false,
  "main": "src/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/DEFRA/lis-apps-sheep-home.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:frontend": "vite build",
    "predev": "npm run build:frontend",
    "dev": "AWS_EMF_ENVIRONMENT=Local npm run server:watch",
    "dev:debug": "AWS_EMF_ENVIRONMENT=Local npm run server:debug",
    "dev:debug:ide": "AWS_EMF_ENVIRONMENT=Local npm run server:debug:ide",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "lint": "run-s lint:js lint:scss",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:scss": "stylelint \"src/**/*.scss\" --cache --cache-location .cache/stylelint --cache-strategy content --color --ignore-path .gitignore",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=istanbul --coverage.reporter=text --coverage.reporter=lcov --coverage.include=\"src/**/*.js\" --coverage.thresholds.statements=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.lines=90",
    "security-audit": "npm audit --audit-level=critical",
    "server:watch": "nodemon --inspect=0 --ext js,json --legacy-watch --watch ./src/server --watch ./src/config --env-file-if-exists=.env ./src",
    "server:debug": "nodemon --inspect-brk=0 --ext js,json --legacy-watch --watch ./src/server --watch ./src/config --env-file-if-exists=.env ./src",
    "server:debug:ide": "node --inspect=0 --use-system-ca --env-file-if-exists=.env ./src",
    "prestart": "npm run build:frontend",
    "start": "NODE_ENV=production node .",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "git:pre-commit-hook": "npm run security-audit && npm run format:check && npm run lint && npm test"
  },
  "imports": {
    "#test-helpers/*": "./test-helpers/*",
    "#*": "./src/*"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@defra/cdp-auditing": "0.6.0",
    "@defra/cdp-metrics": "0.6.0",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.0",
    "@defra/lis-hubs-infra-access": "0.2.0",
    "@defra/lis-infra-ui-services": "0.1.0",
    "@defra/lis-species-sheep": "^0.2.0",
    "@defra/lis-taxonomy-home": "0.5.0",
    "@hapi/catbox-memory": "6.0.2",
    "@hapi/catbox-redis": "7.0.2",
    "@hapi/hapi": "21.4.10",
    "@hapi/inert": "7.1.2",
    "@hapi/scooter": "8.0.0",
    "@hapi/vision": "7.0.3",
    "@hapi/yar": "11.0.3",
    "blankie": "5.0.0",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "cssnano": "7.1.5",
    "cssnano-preset-default": "7.0.13",
    "date-fns": "4.4.0",
    "govuk-frontend": "6.4.0",
    "hapi-pulse": "3.0.1",
    "ioredis": "5.8.2",
    "jose": "6.2.3",
    "lodash": "4.18.1",
    "node-fetch": "3.3.2",
    "nunjucks": "3.2.4",
    "semver": "7.8.5"
  },
  "peerDependencies": {
    "eslint": "^9.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "7.29.2",
    "@defra/hapi-connect": "1.0.1",
    "@defra/lis-infra-eslint-config": "^0.6.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "audit-ci": "^7.1.0",
    "cheerio": "1.2.0",
    "eslint": "^9.0.0",
    "husky": "9.1.7",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "prettier": "^3.9.6",
    "sass-embedded": "1.102.0",
    "stylelint": "17.14.1",
    "stylelint-config-gds": "3.0.0",
    "vite": "8.2.1",
    "vitest": "^4.1.10",
    "vitest-fetch-mock": "0.4.5"
  }
}
